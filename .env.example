# PostgreSQL connection. Use a managed PostgreSQL provider in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blood_donor?schema=public"
POSTGRES_PASSWORD="dev-only-change-me"

# Generate a random secret of at least 32 characters. Keep it private.
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
APP_URL="http://localhost:3000"

# Hospital password reset email. Configure a verified sender in Resend.
RESEND_API_KEY=""
PASSWORD_RESET_FROM=""

# Google OAuth. Configure the redirect URI at /api/hospital/google/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Twilio voice settings. Leave unset to run without outbound calls.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Required only for the initial hospital seed. Never use a default password.
SEED_HOSPITAL_NAME="City General Hospital"
SEED_HOSPITAL_ADDRESS="123 Example Street, New York, NY"
SEED_HOSPITAL_EMAIL="hospital@example.org"
SEED_HOSPITAL_PASSWORD=""
SEED_HOSPITAL_LATITUDE="40.7128"
SEED_HOSPITAL_LONGITUDE="-74.0060"
